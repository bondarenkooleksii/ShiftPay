{
  "name": "shiftpay",
  "private": true,
  "version": "1.0.0",
  "description": "ShiftPay - Shift tracking and payroll management web application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
